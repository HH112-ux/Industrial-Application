# 复制为 .env 后填写真实值: cp .env.example .env
# ⚠️  切勿将 .env 提交到代码仓库

# 数据库配置
# 应用连接账号：受限专用账号，仅拥有 zhizao_xietong 库的 DML 与 Flyway 迁移所需 DDL
# 可用依赖注入的自定义账号名；compose 中的 mysql-init 会按该账号建号并重置口令
DB_USERNAME=zhizao_app
# docker compose 必填：应用账号口令；留空会导致 compose 直接启动失败
DB_PASSWORD=
# docker compose 必填：MySQL root 口令；仅 mysql-init 建号/授权、mysql 健康检查与备份/恢复脚本使用
# 不要与 DB_PASSWORD 复用同一口令
MYSQL_ROOT_PASSWORD=
# 宿主机调试端口（仅绑定 127.0.0.1，不对内网发布）
MYSQL_PORT=3306
# 后端容器端口与内存上限（compose 变量，不会进入容器环境）
# 后端 8080 只绑 127.0.0.1，外部统一经前端 nginx；本机调试走 SSH 隧道
BACKEND_PORT=8080
# 后端容器内存上限，JVM 堆按该值的 75% 推导（-XX:MaxRAMPercentage=75）
BACKEND_MEM_LIMIT=1g

# JWT 密钥（生产环境请使用随机 256 位字符串，例如: openssl rand -base64 64）
# docker compose 必填：留空会导致 compose 直接启动失败
# 应用启动期强制校验：少于 32 字节（HS256 最短 256 位）同样启动失败，并打印当前字节数
JWT_SECRET=

# 接口文档（Swagger / OpenAPI）开关：默认关闭，生产不暴露；仅内部或 dev 环境按需打开
API_DOCS_ENABLED=false
# 可信反向代理的固定 IP（逗号分隔）。留空表示不采信 X-Forwarded-For，审计 IP 取 TCP 对端地址。
# 部署在 Nginx/SLB 之后时必须填写离应用最近一级代理的 IP（多级代理需逐级填写），否则审计来源 IP
# 会恒为代理地址、失去追溯价值。留空时应用启动会输出 WARN；若请求携带 X-Forwarded-For 但未配置
# 可信代理，还会在运行期再告警一次（该头仍会被忽略，默认 fail-closed 不变）。
# 地址写法需与服务端返回一致：IPv4 直接填写，IPv6 建议填写完整展开形式
TRUSTED_PROXIES=
# 登录 IP 维度限流阈值（次/分钟），账号维度固定 10 次/分钟，设为 0 关闭 IP 维度。
# 默认 compose 部署在自带 nginx 之后：TRUSTED_PROXIES 为空时后端只看到 nginx 容器地址，
# 所有用户共用一个 IP 桶，换班集中登录可能触发限流；此时请配置 TRUSTED_PROXIES，或调高本值。
LOGIN_IP_MAX_ATTEMPTS=30

# 初始管理员口令（仅首次创建 admin 时使用）
# 非 dev 环境必须显式注入：未设置时启动直接失败（IllegalStateException），不会静默生成口令
# dev 环境可留空：启动时生成一次性随机口令并以 WARN 打印到日志，登录后请立即修改
APP_BOOTSTRAP_ADMIN_PASSWORD=
# dev profile 下演示账号 zhangsan 的口令（仅 dev 生效；留空则生成随机口令并以 WARN 打印）
DEMO_INIT_PASSWORD=
# dev profile 下演示账号 zhangsan 的车间数据域（仅 dev 生效）
# 留空则不预设车间：账号仍可登录，但按 deny-by-default 看不到任何车间业务数据
DEMO_INIT_WORKSHOP=

# 演示种子数据开关（默认关闭）：关闭时空库启动不写入演示设备/物料/工艺/计划
# 仅本地或演示环境设为 true；已上线的存量库请保持 false
APP_SEED_DEMO_ENABLED=false

# CORS 允许的前端源（多个用逗号分隔，必须带协议与端口）
# docker compose 必填：留空会导致 compose 直接启动失败（不再静默回落 localhost）
# 生产必须填实际访问地址（如 https://mes.example.com），浏览器登录依赖该白名单
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Redis 配置
# docker compose 必填：Redis 开启 requirepass，未设置会导致 compose 直接启动失败
# 生成示例：openssl rand -base64 32；口令含 $ 时请写成单引号，否则 compose 会按变量插值截断
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT 配置（可选；docker compose 中为必填：Broker 已关闭匿名接入）
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
# docker compose 必填：compose 启动时用这两个值生成 Mosquitto 口令文件，明文不入仓库
MQTT_USERNAME=
MQTT_PASSWORD=
# 以下 4 项由 docker compose 显式透传给 backend（改动会生效，不再被容器内默认值覆盖）
MQTT_TOPIC=factory/devices/+/status
# 设备入口端口：TLS 向内网发布；明文 1883 只绑 127.0.0.1 供本机调试
# 需先执行 ./scripts/gen-mqtt-certs.sh 生成证书，否则 mqtt 启动失败
MQTT_TLS_PORT=8883
# ACL 允许该共享账号读写的主题，空格分隔；未匹配的主题一律拒绝
# 多主题示例：factory/devices/+/status factory/devices/+/telemetry
# 必须覆盖 MQTT_TOPIC：mqtt-init 用它生成 Broker ACL，backend 启动时比对订阅主题；
# 若修改 MQTT_TOPIC 却没同步扩展本项，Broker 会拒绝订阅（SUBACK 0x80），启动日志将输出 WARN
MQTT_ACL_TOPICS=factory/devices/+/status
# 多实例部署时每个实例必须使用不同值，否则会互相顶掉持久会话
MQTT_CLIENT_ID=zhizao-backend
MQTT_QOS=1

# 设备接入可靠性
# 注意：除 DEVICE_AUTH_ENABLED 与 DEVICE_CREDENTIAL_KEY 外，下列 DEVICE_* 不会由 compose 透传，
# 容器内取 application.yml 默认值；需要调整时请按 README「docker compose 环境变量透传」手工追加
# 超过该秒数未上报即视为离线
DEVICE_ONLINE_THRESHOLD_SECONDS=90
# 无真实上报时是否返回模拟遥测，默认关闭
DEVICE_SIMULATION_ENABLED=false
# 设备上报 HMAC 鉴权：默认关闭，兼容尚未改造的存量设备；compose 已透传该变量
# 开启后未带凭据、签名错误、时间戳越界或凭证已吊销的上报会被拒绝（REST 401/403，MQTT 丢弃并记 WARN）
# 开启时必须同时填写 DEVICE_CREDENTIAL_KEY，否则后端启动直接失败
DEVICE_AUTH_ENABLED=false
DEVICE_SIGNATURE_TOLERANCE_SECONDS=300
# 32 字节主密钥的 Base64，用于加密设备密钥；生成示例：openssl rand -base64 32
# 只放部署环境，不提交仓库；轮换主密钥前必须先为全部设备重签凭证，否则旧密文无法解密
DEVICE_CREDENTIAL_KEY=
DEVICE_IDEMPOTENCY_TTL_SECONDS=600
DEVICE_IDEMPOTENCY_MAX_ENTRIES=10000
# 遥测时序保留天数，每天 03:30 清理更早的数据
DEVICE_TELEMETRY_RETENTION_DAYS=90

# 设备报警企业微信通知（可选）
# 默认关闭；开启后 corpId / agentId / secret 任一为空时静默跳过发送，不影响报警落库
# 注意：DEVICE_ALARM_* 不会被 docker compose 自动透传，需按 README「docker compose 环境变量透传」手工追加
DEVICE_ALARM_WECOM_ENABLED=false
DEVICE_ALARM_WECOM_CORP_ID=
DEVICE_ALARM_WECOM_AGENT_ID=
DEVICE_ALARM_WECOM_SECRET=
DEVICE_ALARM_WECOM_CONNECT_TIMEOUT_MS=2000
DEVICE_ALARM_WECOM_READ_TIMEOUT_MS=3000
DEVICE_ALARM_WECOM_QUEUE_CAPACITY=200

# AI 只读数据源（可选）：配置后 AI 查询走独立只读账号
# 留空则回落主数据源，启动时输出 WARN，隔离仅依赖 SQL 正则与只读事务
AI_DATASOURCE_URL=
AI_DATASOURCE_USERNAME=
AI_DATASOURCE_PASSWORD=

# 企业微信扫码登录（可选）
# 总开关默认关闭；关闭时登录端点返回明确拒绝，本地账号登录不受影响
# 注意：除 SSO_COOKIE_SECURE 外的 SSO_* 不会被 docker compose 自动透传，需按 README「docker compose 环境变量透传」手工追加
SSO_ENABLED=false
# SSO 浏览器标识 Cookie 是否带 Secure：HTTPS 部署保持 true（默认），仅本机 http 调试可设为 false
SSO_COOKIE_SECURE=true
# 是否允许未开通的企微用户首次扫码时自动建号（JIT），默认关闭
# 关闭时未建号用户扫码返回「账号未开通，请联系管理员」，由管理员在用户管理里创建账号
SSO_JIT_ENABLED=false
# 开启后以下四项必填，缺任一项应用启动失败（不做静默降级）
# 真实值只写在部署环境的环境变量里，切勿提交到仓库
SSO_WECOM_CORP_ID=
SSO_WECOM_AGENT_ID=
SSO_WECOM_SECRET=
# 企微授权成功后的前端回调页（需为企微可信域名下的 HTTPS 地址）
SSO_WECOM_REDIRECT_URI=
# 仅 dev/test 可用：用固定假身份跑通链路，生产环境不会装配
SSO_FAKE_PROVIDER_ENABLED=false
